# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE environment file — PLACEHOLDERS ONLY. Never put a real secret here.
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# `.env` is git-ignored (.gitignore: `.env*`) and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL only. This project does NOT support MongoDB — prisma/schema.prisma
# declares the `postgresql` provider, and the app refuses to start if this value
# begins with `mongodb://`.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/hr_system"

# Used for migrations and introspection. Set to the same value as DATABASE_URL
# unless your host requires a separate direct (non-pooled) connection.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5433/hr_system"


# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED in every environment. The launcher replaces this placeholder with a
# 32-byte value from the OS CSPRNG the first time you run it, so you normally
# never type a value here. If you would rather set it yourself, use a real
# CSPRNG and keep the output to hex characters:
#
#   openssl rand -hex 32                            (macOS / Linux)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   powershell -NoProfile -Command "$b=New-Object byte[] 32;
#     [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);
#     [System.BitConverter]::ToString($b).Replace('-','')"
#
# Hex rather than base64: base64 output can contain '+', '/' and '=', which are
# shell metacharacters, so it is easy to corrupt when pasted through cmd.exe or
# PowerShell. 64 hex characters is a lossless encoding of the same 32 bytes
# (256 bits) and needs no escaping anywhere.
#
# Do NOT use a value from this file, and do NOT reuse a development secret in
# production. Rotating AUTH_SECRET invalidates every issued session, so plan a
# rotation window before changing it in production. See
# docs/audit/SECRETS_ROTATION.md for the full procedure.
AUTH_SECRET="REPLACE_WITH_32_BYTE_CSPRNG_HEX"


# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank to disable the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ── Backups (scripts/backup.ps1) ─────────────────────────────────────────────
# Read by scripts/backup.ps1. Precedence is: an explicit parameter on the
# command line wins over the environment, and the environment wins over the
# script's own default. So `-Keep 30` beats `BACKUP_KEEP=14`, which beats the
# built-in default of 14. An unset or non-numeric value is ignored and logged,
# never coerced.
#
# How many dated dumps to keep. Older dumps are pruned only after a new dump has
# been taken, validated and checksummed, and the newest dump is never deleted:
# 0 is clamped to 1 rather than obeyed.
BACKUP_KEEP=14

# WHICH DATABASE THIS HOST PROTECTS. Read first by scripts/backup.ps1, because
# every other backup default depends on it.
#
#   development  canonical container `hr-postgres`    (port 5433, POSTGRES_USER
#                 `postgres`; the container created by the local dev launcher
#                 and used by DATABASE_URL / `npm run dev`)
#   production   canonical container `hr_system_db`    (port 5432, POSTGRES_USER
#                 `hr_admin`; the `db` service of docker-compose.yml, volume
#                 hr_system-main_pgdata)
#
# Both containers are in real use on a machine that runs both. Setting nothing
# is not neutral: the default below is `development`, it is announced LOUDLY on
# every run, and a host that sets nothing will take nightly backups of the
# DEVELOPMENT database while an administrator believes PRODUCTION is covered.
# That is finding 1 of docs/audit/BACKUP_AUDIT_PHASE1.md.
#
# There is also a hard fail-safe: with BACKUP_ENV=production, backup.ps1 exits
# non-zero BEFORE dumping anything if the resolved container is anything other
# than `hr_system_db`, naming both containers in the error. That combination is
# never worked around.
BACKUP_ENV=development

# Container holding the database to dump. Overrides the canonical container for
# the chosen BACKUP_ENV; normally you leave it EMPTY and let BACKUP_ENV decide,
# because that is the one setting that cannot drift out of step with the
# environment it is supposed to describe.
#
# WARNING - READ FINDING 1 IN docs/audit/BACKUP_AUDIT_PHASE1.md BEFORE SETTING
# THIS ON A PRODUCTION HOST. A value left here as `hr-postgres` is a
# DEVELOPMENT container. It is safe on a production-only host (the container
# does not exist, so the task fails loudly) and DANGEROUS on a host running
# both, where the task would succeed nightly against development.
BACKUP_CONTAINER=

# Role the dump runs as. Empty means the per-environment default:
# `postgres` for development, `hr_admin` for production, which is what
# docker-compose.yml sets. No password is ever needed or passed: pg_dump and
# psql authenticate inside the container over its local unix socket.
BACKUP_DB_USER=

# Database name inside the container. Empty means `hr_system`. backup.ps1
# verifies the database exists before dumping, so a wrong name fails with a
# clear message instead of producing a truncated .sql file.
BACKUP_DB_NAME=

# Where dumps are written. Empty means ./backups next to the repository root.
# backups/ is git-ignored; a dump is a full extract of every employee's record
# and must never be committed. Point this at a volume path on a production
# host, not at a directory on the application disk.
BACKUP_DIR=


# ── Microsoft Entra ID / Azure AD (optional) ─────────────────────────────────
# Create an App Registration at https://portal.azure.com
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
# Restrict `MICROSOFT_TENANT_ID` to your own tenant in production.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
