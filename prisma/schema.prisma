generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

generator client_default {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  emailVerified         DateTime?
  image                 String?
  password              String? // Hashed, null for OAuth users
  role                  String         @default("STAFF")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  employee              Employee?
  roleRequests          RoleRequest[]
  approvedLeavesManager LeaveRequest[] @relation("ManagerApprovals")
  approvedLeavesHR      LeaveRequest[] @relation("HRApprovals")
  accounts              Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RoleRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  requestedRole String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── EMPLOYEE MASTER TABLE (Central Entity) ───────────────────────────────────
model Employee {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeCode           String?          @unique // Auto-generated: EMP-001
  firstName              String
  lastName               String
  email                  String           @unique
  rollNumber             String           @unique
  photo                  String?
  phone                  String?
  gender                 String?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          String?
  designation            String
  department             String
  joiningDate            DateTime
  employmentType         String           @default("FULL_TIME")
  workLocation           String?
  probationDays          Int              @default(90)
  currentStatus          String           @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  isActive               Boolean          @default(true)
  address                String?
  permanentAddress       String?
  emergencyContact       String?
  emergencyPhone         String?
  governmentId           String?
  bankName               String?
  accountNumber          String?
  iban                   String?
  ifscCode               String?
  basicSalary            Float?
  housingAllowance       Float?
  transportAllowance     Float?
  otherAllowance         Float?
  passportNumber         String?
  passportExpiry         DateTime?
  emiratesId             String?
  emiratesIdExpiry       DateTime?
  visaNumber             String?
  visaExpiry             DateTime?
  visaType               String?
  medicalInsuranceExpiry DateTime?
  iloeInsuranceExpiry    DateTime?
  shiftId                String?
  shift                  Shift?           @relation(fields: [shiftId], references: [id])
  leaveRequests          LeaveRequest[]
  leaveBalances          LeaveBalance[]
  attendance             Attendance[]
  salaryStructure        SalaryStructure?
  salaryRecords          SalaryRecord[]
  letterRecords          LetterRecord[]
  serviceRequests        ServiceRequest[]
  visaRequests           VisaRequest[]
  letters                Letter[]
  letterRequests         LetterRequest[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  loanApplications       LoanApplication[]
  overtime               Overtime[]
  salaryAdvances         SalaryAdvanceRequest[]
  reimbursements         ReimbursementRequest[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  managerId              String?
  manager                Employee?        @relation("ManagerToStaff", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportees              Employee[]       @relation("ManagerToStaff")
  requestedJobs          JobRequisition[] @relation("RequestedJobs")
  interviews             Interview[]      @relation("Interviewer")
}

// ─── LEAVE BALANCE (Auto-created on employee onboarding) ─────────────────────
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveType  String // ANNUAL, SICK, CASUAL, EMERGENCY, UNPAID, MATERNITY, PATERNITY, etc.
  totalDays  Int      @default(0)
  usedDays   Int      @default(0)
  year       Int // Calendar year this balance applies to
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title      String
  message    String
  type       String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead     Boolean  @default(false)
  link       String? // Optional deep link
  createdAt  DateTime @default(now())
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────
model Attendance {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          String         @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE, HOLIDAY
  lateMinutes     Int            @default(0)
  overtimeMinutes Int            @default(0)
  shiftId         String?
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  biometricLogs   BiometricLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Shift {
  id            String       @id @default(cuid())
  name          String
  startTime     String
  endTime       String
  lateThreshold Int          @default(15)
  weeklyOffs    String
  employees     Employee[]
  attendance    Attendance[]
}

model BiometricLog {
  id           String      @id @default(cuid())
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  deviceId     String?
  employeeId   String
  timestamp    DateTime
  type         String // IN, OUT
  rawLog       String?
}

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  details    String?
  changedBy  String
  createdAt  DateTime @default(now())
}

// ─── LEAVE ────────────────────────────────────────────────────────────────────
model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  type          String
  startDate     DateTime
  endDate       DateTime
  reason        String
  managerStatus String   @default("PENDING")
  managerId     String?
  manager       User?    @relation("ManagerApprovals", fields: [managerId], references: [id])
  hrStatus      String   @default("PENDING")
  hrId          String?
  hr            User?    @relation("HRApprovals", fields: [hrId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── PAYROLL ──────────────────────────────────────────────────────────────────
model SalaryStructure {
  id                 String   @id @default(cuid())
  employeeId         String   @unique
  employee           Employee @relation(fields: [employeeId], references: [id])
  ctc                Float    @default(0)
  basic              Float    @default(0)
  housingAllowance   Float    @default(0)
  transportAllowance Float    @default(0)
  medicalAllowance   Float    @default(0)
  foodAllowance      Float    @default(0)
  travelAllowance    Float    @default(0)
  commission         Float    @default(0)
  otherAllowances    Float    @default(0)
  paymentMethod      String   @default("BANK_TRANSFER")
  bankName           String?
  iban               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SalaryRecord {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  month              Int
  year               Int
  basic              Float
  housingAllowance   Float     @default(0)
  transportAllowance Float     @default(0)
  medicalAllowance   Float     @default(0)
  foodAllowance      Float     @default(0)
  travelAllowance    Float     @default(0)
  commission         Float     @default(0)
  otherAllowances    Float     @default(0)
  latePenalty        Float     @default(0)
  penalty            Float     @default(0)
  leaveDeduction     Float     @default(0)
  loanDeduction      Float     @default(0)
  advanceSalary      Float     @default(0)
  otherDeductions    Float     @default(0)
  overtimePay        Float     @default(0)
  bonus              Float     @default(0)
  netSalary          Float
  status             String    @default("DRAFT") // DRAFT, PENDING_HR, PENDING_FINANCE, PENDING_MANAGEMENT, PROCESSED, PAID, CANCELLED
  paymentMethod      String    @default("BANK_TRANSFER")
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LoanType {
  id                 String   @id @default(cuid())
  name               String   @unique // e.g. "Personal Loan", "Salary Advance"
  description        String?
  maxAmount          Float
  interestRate       Float    @default(0)
  maxRepaymentMonths Int
  requiresProbation  Boolean  @default(true)
  isActive           Boolean  @default(true)
  applications       LoanApplication[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LoanApplication {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  loanTypeId       String
  loanType         LoanType @relation(fields: [loanTypeId], references: [id])
  requestedAmount  Float
  repaymentMonths  Int
  reason           String?
  status           String   @default("DRAFT") // DRAFT, SUBMITTED, PENDING_MANAGER, PENDING_HR, PENDING_FINANCE, APPROVED, REJECTED, DISBURSED, CLOSED, CANCELLED
  managerStatus    String   @default("PENDING")
  hrStatus         String   @default("PENDING")
  financeStatus    String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  approvals        LoanApproval[]
  disbursements    LoanDisbursement[]
  installments     LoanInstallment[]
  documents        LoanDocument[]
}

model LoanApproval {
  id                String   @id @default(cuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id])
  approverEmail     String
  level             String   // MANAGER, HR, FINANCE, FINAL
  action            String   // APPROVED, REJECTED, ON_HOLD
  comments          String?
  createdAt         DateTime @default(now())
}

model LoanDisbursement {
  id                String   @id @default(cuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id])
  method            String   // BANK_TRANSFER, CASH, SALARY_CREDIT
  amount            Float
  transactionRef    String?
  disbursedAt       DateTime @default(now())
}

model LoanInstallment {
  id                String   @id @default(cuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id])
  month             Int
  year              Int
  amount            Float
  status            String   @default("PENDING") // PENDING, DEDUCTED, SKIPPED
  deductedAt        DateTime?
  createdAt         DateTime @default(now())
}

model LoanDocument {
  id                String   @id @default(cuid())
  applicationId     String
  application       LoanApplication @relation(fields: [applicationId], references: [id])
  fileUrl           String
  fileName          String
  uploadedAt        DateTime @default(now())
}

model LoanNotification {
  id                String   @id @default(cuid())
  targetEmail       String
  title             String
  message           String
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Overtime {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  hours       Float
  ratePerHour Float
  totalPay    Float
  status      String   @default("PENDING") // PENDING, APPROVED, PAID, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── UAE SERVICE REQUESTS ──────────────────────────────────────────────────────
model ServiceCategory {
  id             String         @id @default(cuid())
  name           String         @unique // e.g. Emirates ID, Visa Services, Medical
  type           String         @default("GENERAL") // GOVERNMENT, VISA, MEDICAL, PAYROLL, LEAVE, HR_LETTER
  icon           String?
  description    String?
  requiresAmount Boolean        @default(false)
  requiresDates  Boolean        @default(false)
  slaDays        Int            @default(3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  requests       ServiceRequest[]
}

model ServiceRequest {
  id              String            @id @default(cuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id])
  categoryId      String
  category        ServiceCategory   @relation(fields: [categoryId], references: [id])
  details         String
  amount          Float?
  startDate       DateTime?
  endDate         DateTime?
  status          String            @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, PRO_PROCESSING, FINANCE_APPROVED, COMPLETED, REJECTED
  workflowStep    Int               @default(1)
  hrNote          String?
  attachments     Attachment[]
  approvals       ServiceApproval[]
  comments        ServiceComment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ServiceApproval {
  id                String         @id @default(cuid())
  serviceRequestId  String
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  approverId        String?
  approverEmail     String?
  level             String         // MANAGER, HR, FINANCE, PRO, CEO
  action            String         // APPROVED, REJECTED
  comments          String?
  createdAt         DateTime       @default(now())
}

model ServiceComment {
  id                String         @id @default(cuid())
  serviceRequestId  String
  serviceRequest    ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  authorId          String
  authorName        String
  content           String
  createdAt         DateTime       @default(now())
}

model ReimbursementRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  category        String   // Fuel, Travel, Mobile, Accommodation, Medical, Misc
  amount          Float
  details         String
  status          String   @default("PENDING")
  attachments     Attachment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SalaryAdvanceRequest {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  requestedAmount Float
  repaymentMonths Int
  reason          String
  status          String   @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, FINANCE_APPROVED, PAID, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── DOCUMENTS & ATTACHMENTS ──────────────────────────────────────────────────
model Attachment {
  id                   String        @id @default(cuid())
  serviceRequestId     String?
  serviceRequest       ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  reimbursementId      String?
  reimbursementRequest ReimbursementRequest? @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  visaRequestId  String?
  visaRequest    VisaRequest?  @relation(fields: [visaRequestId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String
  category       String
  docNumber      String?
  docExpiry      DateTime?
  createdAt      DateTime      @default(now())
}

// ─── VISA APPLICATIONS ────────────────────────────────────────────────────────
model VisaRequest {
  id                 String       @id @default(cuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id])
  visaType           String
  destinationCountry String
  purpose            String
  status             String       @default("PENDING")
  notes              String?
  attachments        Attachment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ─── LETTERS ──────────────────────────────────────────────────────────────────
model LetterRecord {
  id            String    @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  type          String
  recipientName String
  details       String?
  generatedAt   DateTime  @default(now())
}

model LetterRequest {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  templateId      String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  reason          String?
  status          String         @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, COMPLETED, REJECTED
  approvals       LetterApproval[]
  generatedLetter Letter?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LetterApproval {
  id                String         @id @default(cuid())
  letterRequestId   String
  letterRequest     LetterRequest  @relation(fields: [letterRequestId], references: [id], onDelete: Cascade)
  approverId        String?
  level             String         // MANAGER, HR
  action            String         // APPROVED, REJECTED
  comments          String?
  createdAt         DateTime       @default(now())
}

model LetterTemplate {
  id         String   @id @default(cuid())
  name       String
  type       String
  content_en String
  content_ar String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  letters    Letter[]
  requests   LetterRequest[]
}

model Letter {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  templateId      String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  referenceNumber String         @unique
  letterRequestId String?        @unique
  letterRequest   LetterRequest? @relation(fields: [letterRequestId], references: [id])
  status          String         @default("DRAFT")
  content_en      String
  content_ar      String?
  pdfUrl          String?
  comments        String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ─── SYSTEM CONFIG ────────────────────────────────────────────────────────────
model ServiceConfig {
  id          String   @id @default(cuid())
  module      String
  key         String
  label       String
  description String?
  type        String
  value       String
  options     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, key])
}

// ─── RECRUITMENT & ONBOARDING ──────────────────────────────────────────────────
model JobRequisition {
  id              String      @id @default(cuid())
  title           String
  department      String
  location        String?
  employmentType  String      @default("FULL_TIME")
  positionsCount  Int         @default(1)
  status          String      @default("OPEN") // OPEN, ON_HOLD, CLOSED, FILLED
  description     String?
  requirements    String?
  minSalary       Float?
  maxSalary       Float?
  requestedById   String
  requestedBy     Employee    @relation("RequestedJobs", fields: [requestedById], references: [id])
  candidates      Candidate[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Candidate {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String         @unique
  phone           String?
  resumeUrl       String?
  status          String         @default("APPLIED") // APPLIED, SCREENING, INTERVIEW, OFFERED, HIRED, REJECTED
  jobId           String
  job             JobRequisition @relation(fields: [jobId], references: [id])
  interviews      Interview[]
  offer           OfferLetter?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Interview {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  interviewerId String
  interviewer   Employee  @relation("Interviewer", fields: [interviewerId], references: [id])
  scheduledAt   DateTime
  durationMins  Int       @default(60)
  status        String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  feedback      String?
  rating        Int?      // 1-5 scale
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OfferLetter {
  id            String    @id @default(cuid())
  candidateId   String    @unique
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  offeredSalary Float
  designation   String
  department    String
  joiningDate   DateTime
  status        String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED
  fileUrl       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
