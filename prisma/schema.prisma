model VisaRequest {
  id                 String       @id @default(cuid())
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id])
  visaType           String
  destinationCountry String
  purpose            String
  status             String       @default("PENDING")
  notes              String?
  attachments        Attachment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ─── LETTERS ──────────────────────────────────────────────────────────────────
model LetterRecord {
  id            String    @id @default(cuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  type          String
  recipientName String
  details       String?
  generatedAt   DateTime  @default(now())

  // --- P1.5 approval + versioning ---
  // A corrected letter creates a NEW row with the next version number. Rows are
  // never overwritten, so the full history of what was issued when is retained.
  /// Stable identity shared by every version of the same logical document.
  documentKey    String    @default("")
  version        Int       @default(1)
  status         String    @default("GENERATED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, GENERATED, VOID
  requiresApproval Boolean @default(false)
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  voidedAt       DateTime?
  voidReason     String?
  supersededById String?

  @@index([documentKey, version])
  @@index([employeeId, type])
  @@index([status])
}

model LetterRequest {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  templateId      String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  reason          String?
  status          String         @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, COMPLETED, REJECTED
  approvals       LetterApproval[]
  generatedLetter Letter?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LetterApproval {
  id                String         @id @default(cuid())
  letterRequestId   String
  letterRequest     LetterRequest  @relation(fields: [letterRequestId], references: [id], onDelete: Cascade)
  approverId        String?
  level             String         // MANAGER, HR
  action            String         // APPROVED, REJECTED
  comments          String?
  createdAt         DateTime       @default(now())
}

model LetterTemplate {
  id         String   @id @default(cuid())
  name       String
  type       String
  content_en String
  content_ar String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  letters    Letter[]
  requests   LetterRequest[]
}

model Letter {
  id              String         @id @default(cuid())
  /// P1 §15/§19: a letter may belong to a CANDIDATE (an offer letter is issued
  /// before the person becomes an Employee), so the employee link is optional.
  /// A letter is only required to have one of employeeId / candidateId.
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id])
  /// Set when this letter was issued against a recruitment offer.
  candidateId     String?
  candidate       Candidate?     @relation(fields: [candidateId], references: [id])
  templateId      String
  template        LetterTemplate @relation(fields: [templateId], references: [id])
  referenceNumber String         @unique
  letterRequestId String?        @unique
  letterRequest   LetterRequest? @relation(fields: [letterRequestId], references: [id])
  /// The offer this letter documents, if any. Reverse side of
  /// `OfferLetter.letterRecord`.
  issuedForOffer  OfferLetter[]
  status          String         @default("DRAFT")
  content_en      String
  content_ar      String?
  pdfUrl          String?
  comments        String?
  approvedBy      String?
  approvedAt      DateTime?
  /// The job this offer letter was issued against, if any.
  jobRequisition  JobRequisition? @relation(fields: [jobRequisitionId], references: [id])
  jobRequisitionId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ─── SYSTEM CONFIG ────────────────────────────────────────────────────────────
model ServiceConfig {
  id          String   @id @default(cuid())
  module      String
  key         String
  label       String
  description String?
  type        String
  value       String
  options     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([module, key])
}

// ─── RECRUITMENT & ONBOARDING ──────────────────────────────────────────────────
model JobRequisition {
  id              String      @id @default(cuid())
  /// REQ-2026-0001. Unique so a requisition is addressable in approvals.
  requisitionCode String?     @unique
  title           String
  department      String
  branch          String?
  location        String?
  employmentType  String      @default("FULL_TIME")
  positionsCount  Int         @default(1)
  /// NEW_POSITION | REPLACEMENT
  positionType    String      @default("NEW_POSITION")
  /// Set when positionType is REPLACEMENT.
  replacementEmployeeId String?
  reason          String?
  requiredSkills  String?
  requiredExperience String?
  requiredEducation String?
  budget          Float?
  minSalary       Float?
  maxSalary       Float?
  /// LOW | MEDIUM | HIGH | URGENT
  priority        String      @default("MEDIUM")
  targetJoiningDate DateTime?
  /// DRAFT | SUBMITTED | MANAGER_REVIEW | HR_REVIEW | FINANCE_REVIEW | APPROVED | REJECTED | CANCELLED
  status          String      @default("DRAFT")
  managerApprovedById String?
  managerApprovedAt   DateTime?
  hrApprovedById  String?
  hrApprovedAt    DateTime?
  financeApprovedById String?
  financeApprovedAt   DateTime?
  approvedAt      DateTime?

  requestedById   String
  requestedBy     Employee    @relation("RequestedJobs", fields: [requestedById], references: [id])
  /// Replaces the old `candidates` direct relation.
  applications    Application[]
  /// Offer letters issued against a vacancy on this requisition.
  offerLetters    Letter[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([department])
}

// ─── RECRUITMENT (P1) ────────────────────────────────────────────────────────
// Restructured. The previous shape had `Candidate.jobId` REQUIRED, which made
// "a candidate may apply to multiple jobs" impossible, and no Application
// entity at all, so the pipeline state machine had nowhere to live.

model Candidate {
  id              String         @id @default(cuid())
  /// Stable external reference, e.g. CAND-0001.
  candidateCode   String?        @unique
  firstName       String
  lastName        String
  email           String         @unique
  phone           String?
  nationality     String?
  currentLocation String?
  resumeUrl       String?
  /// Comma-separated skills; a dedicated join table is a later refinement.
  skills          String?
  currentEmployer String?
  currentPosition String?
  expectedSalary  Float?
  noticePeriodDays Int?
  availableFrom   DateTime?
  /// CAREER_PAGE | REFERRAL | LINKEDIN | JOB_PORTAL | AGENCY | DIRECT | EMPLOYEE_REFERRAL | OTHER
  source          String         @default("DIRECT")
  tags            String?
  notes           String?
  /// Data-processing consent. Applications are refused without it.
  consentGiven    Boolean        @default(false)
  consentAt       DateTime?
  /// A candidate is a person; a job is a role. They are linked by Application.
  /// Letters of which this candidate is the subject (offer letters).
  letters            Letter[]
  applications    Application[]
  interviews      Interview[]
  offers          OfferLetter[]
  joiningRecords  JoiningRecord[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([lastName, firstName])
  @@index([source])
}

/// One application: a Candidate applying to one JobRequisition.
/// This is where the pipeline state lives (brief §6).
model Application {
  id              String        @id @default(cuid())
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRequisitionId String
  jobRequisition  JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)

  /// APPLIED | SCREENING | SHORTLISTED | INTERVIEW | ASSESSMENT | SELECTED |
  /// OFFERED | OFFER_ACCEPTED | OFFER_DECLINED | REJECTED | WITHDRAWN | HIRED
  status          String        @default("APPLIED")
  /// Snapshot of screening answers (brief §7).
  screeningStatus String?
  screeningNotes  String?
  /// SHORTLIST | HOLD | REJECT
  screeningRecommendation String?
  screenedBy      String?
  screenedAt      DateTime?
  rating          Float?
  appliedAt       DateTime      @default(now())
  lastTransitionAt DateTime     @default(now())
  decidedAt       DateTime?

  interviews     Interview[]
  assessments    Assessment[]
  offers         OfferLetter[]
  joiningRecords JoiningRecord[]

  /// A candidate may not hold two live applications for the SAME job, but may
  /// hold many across different jobs. Enforced by a partial unique index
  /// created in migration, not by application code alone.
  @@unique([candidateId, jobRequisitionId])
  @@index([jobRequisitionId, status])
  @@index([candidateId, status])
}

model Interview {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// The panel is a first-class join (brief §11), not a single interviewerId.
  interviewers  InterviewParticipant[]
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// HR | TECHNICAL | MANAGER | PANEL | FINAL
  interviewType String      @default("HR")
  /// 1-based round. Guards ordering.
  round          Int         @default(1)
  /// ONLINE | ONSITE
  mode           String      @default("ONSITE")
  location       String?
  meetingLink    String?
  scheduledAt    DateTime
  startAt        DateTime
  endAt          DateTime
  coordinatorId  String?
  status         String      @default("SCHEDULED")

  feedback       InterviewFeedback[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([scheduledAt])
  @@index([status])
}

/// One row per interviewer. Enables a panel without a schema change.
model InterviewParticipant {
  id           String    @id @default(cuid())
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String
  /// Denormalised for read convenience; the authority is the Employee record.
  interviewerName String
  employee      Employee? @relation(fields: [interviewerId], references: [id])
  isLead       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  feedback     InterviewFeedback[]

  @@unique([interviewId, interviewerId])
  @@index([interviewerId])
}

/// Structured, per-interviewer feedback (brief §10).
/// One interviewer can never overwrite another's: the unique key is
/// (participantId), not (interviewId).
model InterviewFeedback {
  id           String              @id @default(cuid())
  interviewId  String
  interview    Interview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participantId String
  participant  InterviewParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Each dimension scored 1-5 by the interviewer, not auto-derived.
  technicalSkills  Int?
  communication    Int?
  problemSolving   Int?
  domainKnowledge  Int?
  teamFit          Int?
  leadership       Int?
  overall          Int?

  strengths       String?
  concerns        String?
  comments        String?
  /// STRONG_HIRE | HIRE | HOLD | NO_HIRE
  recommendation  String?
  submittedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// One submission per interviewer per interview.
  @@unique([participantId])
  @@index([interviewId])
}

model Assessment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// TECHNICAL_TEST | PRACTICAL_TEST | WRITTEN_TEST | LANGUAGE_TEST | SKILL_ASSESSMENT
  assessmentType String
  assignedAt    DateTime    @default(now())
  dueAt         DateTime?
  completedAt   DateTime?
  maxScore      Float?
  score         Float?
  /// PASS | FAIL | PENDING
  result        String      @default("PENDING")
  evaluatorId   String?
  attachmentUrl String?
  comments      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

/// Offer. Previously `candidateId` was @unique, which meant a candidate could
/// never receive a second, revised offer. Now versioned (brief §14, §23).
model OfferLetter {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  offeredSalary Float
  designation   String
  department    String
  joiningDate   DateTime
  /// DRAFT | PENDING_APPROVAL | APPROVED | SENT | VIEWED | ACCEPTED | DECLINED | EXPIRED | WITHDRAWN
  status        String      @default("DRAFT")
  /// Version within one application. Previous versions are never overwritten.
  version       Int         @default(1)
  allowances    Float       @default(0)
  benefits      String?
  probationPeriodMonths Int?
  offerExpiry   DateTime?
  contractType  String?
  offeredById   String?
  approvedById  String?
  approvedAt    DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  /// ACCEPTED_IN_PERSON | ACCEPTED_ONLINE | ACCEPTED_EMAIL
  acceptanceMethod String?
  fileUrl       String?
  supersededById String?
  /// Reuse of the existing Letters engine, not a second PDF pipeline (P1 §15).
  letterRecordId String?
  letterRecord   Letter?  @relation(fields: [letterRecordId], references: [id])
  joiningRecords JoiningRecord[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([candidateId, version])
  @@index([status])
  @@index([applicationId])
}

// ─── EXIT LIFECYCLE (resignation / termination / end of contract) ───────────
//
// One exit case per departure, plus the two records that exist only because the
// departure happened: the exit interview and the rehire eligibility decision.
//
// ON DELETE, chosen deliberately (checklist item 6.5 — records being
// destroyed):
//
//   * Nothing is CASCADEd from Employee. Deleting an employee must be REFUSED
//     while an exit case or a rehire assessment exists, not silently take the
//     evidence with it. This is the opposite of `OnboardingChecklistItem`, which
//     cascades: an onboarding checklist is provisioning state, an exit case is a
//     record someone can be held to.
//   * The User actor relations are Restrict, not SetNull. SetNull would quietly
//     erase who approved a termination the moment that administrator's account
//     was removed. The fields are nullable because a case legitimately exists
//     before anyone has decided it, and nullability is what expresses "not
//     decided yet" without a fake value.
//   * The two child tables DO cascade from ExitCase, matching
//     `OffboardingChecklistItem.offboarding`. An exit interview is a component
//     of its case and has no independent owner or meaning, so removing the case
//     removes the component. The case itself is the record that is protected.

/// The departure itself. `status` is a state-machine value, not a free label;
/// the legal moves live in `lib/workflow/exit/state-machine.ts`.
model ExitCase {
  id           String   @id @default(cuid())
  employeeId   String
  /// Restrict, not Cascade — see the note above. An employee with an exit on
  /// record cannot be deleted; the record outlives any attempt to remove it.
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// RESIGNATION | TERMINATION | END_OF_CONTRACT
  type         String
  /// REQUESTED, PENDING_APPROVAL, APPROVED, REJECTED, WITHDRAWN, NOTICE_PERIOD,
  /// INTERVIEW_PENDING, INTERVIEW_COMPLETED, CLEARANCE_PENDING,
  /// SETTLEMENT_PENDING, COMPLETED, CANCELLED
  status       String   @default("REQUESTED")
  /// The employee's stated reason, or HR's stated reason for a termination.
  reason       String?
  /// Recorded by the action, not defaulted, so a back-dated request is visible
  /// as back-dated instead of looking like it was raised today.
  requestedAt  DateTime @default(now())
  /// Contractual end date. Distinct from `lastWorkingDate`: the last day worked
  /// can be shortened by notice, the effective date cannot.
  effectiveDate     DateTime?
  lastWorkingDate   DateTime?
  /// INPUT, NOT A POLICY. Statutory and contractual notice periods differ by
  /// jurisdiction, contract and length of service, so no value is computed
  /// here. Null means "not yet agreed"; the caller must supply it or configure
  /// `EXIT_POLICY.noticePeriodDays` in lib/workflow/exit/state-machine.ts, which
  /// ships unset.
  noticePeriodDays  Int?
  initiatedById      String?
  initiatedBy        User?    @relation("ExitCaseInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedById        String?
  decidedBy          User?    @relation("ExitCaseDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decidedAt          DateTime?
  /// Why a case was approved, rejected or withdrawn. Kept separate from
  /// `reason`, which describes the departure rather than the decision.
  decisionNote       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  interview  ExitInterview?
  rehire     RehireRecord?

  @@index([employeeId])
  @@index([status])
  @@index([status, type])
}

/// The exit interview. `rating` is a raw 1–5 answer supplied by the
/// interviewer; nothing derives from it here, and no default is imposed.
model ExitInterview {
  id           String   @id @default(cuid())
  /// One interview per case. The unique constraint is the database-level
  /// double-submit guard; the action additionally re-validates the case status
  /// inside the transaction before writing.
  exitCaseId   String   @unique
  exitCase     ExitCase @relation(fields: [exitCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conductedById String
  conductedBy  User     @relation("ExitInterviewConductedBy", fields: [conductedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  conductedAt  DateTime @default(now())
  /// 1–5, or null when the interview happened but was not scored. Stored as
  /// given: a stored rating is a claim about what the leaver said.
  rating       Int?
  /// NULLABLE ON PURPOSE. Null means the question was not put or was declined.
  /// Defaulting it to false would manufacture a negative answer that HR then
  /// filters rehire candidates on.
  wouldRejoin  Boolean?
  comments     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Whether this former employee may be rehired. Points at the PRIOR employee,
/// so the record survives the person returning under a new Employee row.
model RehireRecord {
  id           String   @id @default(cuid())
  /// The employee who left. Restrict — the assessment is evidence about this
  /// person and must not vanish with them.
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  /// One eligibility decision per exit. Re-assessment overwrites the row
  /// deliberately (the newest decision is the current one) and every
  /// overwriting write also appends an AuditLog row, so the earlier answer
  /// remains recoverable.
  exitCaseId   String   @unique
  exitCase     ExitCase @relation(fields: [exitCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  eligible     Boolean
  assessedAt   DateTime @default(now())
  assessedById String
  assessedBy   User     @relation("RehireAssessedBy", fields: [assessedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId, eligible])
}
