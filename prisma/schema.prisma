  icon           String?
  description    String?
  requiresAmount Boolean        @default(false)
  requiresDates  Boolean        @default(false)
  slaDays        Int            @default(3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  requests       ServiceRequest[]
}

model ServiceRequest {
  id              String            @id @default(cuid())
  employeeId      String
  employee        Employee          @relation(fields: [employeeId], references: [id])
  categoryId      String
  category        ServiceCategory   @relation(fields: [categoryId], references: [id])
  details         String
  amount          Float?
  startDate       DateTime?
  endDate         DateTime?
  status          String            @default("PENDING") // PENDING, MANAGER_APPROVED, HR_APPROVED, PRO_PROCESSING, FINANCE_APPROVED, COMPLETED, REJECTED
