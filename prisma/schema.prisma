generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

generator client_default {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(cuid())
  name                  String?
  email                 String         @unique
  emailVerified         DateTime?
  image                 String?
  password              String? // Hashed, null for OAuth users
  role                  String         @default("STAFF")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  employee              Employee?
  roleRequests          RoleRequest[]
  approvedLeavesManager LeaveRequest[] @relation("ManagerApprovals")
  approvedLeavesHR      LeaveRequest[] @relation("HRApprovals")
  accounts              Account[]

  // --- P1 workflow relations ---
  passwordResetTokens   PasswordResetToken[]
  securityFlag          UserSecurityFlag?

  // --- Exit lifecycle relations (see the Exit* models at the end of this file)
  // Every one of these is a *named* relation because a single User appears in
  // four different roles on an exit case, and Prisma cannot infer four
  // relations to the same model on one side.
  exitCasesInitiated    ExitCase[]        @relation("ExitCaseInitiatedBy")
  exitCasesDecided      ExitCase[]        @relation("ExitCaseDecidedBy")
  exitInterviews        ExitInterview[]   @relation("ExitInterviewConductedBy")
  rehireAssessments     RehireRecord[]    @relation("RehireAssessedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model RoleRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  requestedRole String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── P1 WORKFLOW SUPPORT ───────────────────────────────────────────────────────
// All models below are ADDITIVE. No existing model was altered and no row is
// removed. Each exists to make a workflow transactional, idempotent, auditable
// or recoverable rather than best-effort.

/// One-time credential issued instead of a shared default password (P1.1,
/// SEC-027). The plaintext token is NEVER stored — only its SHA-256 hash.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  purpose     String    @default("FIRST_LOGIN") // FIRST_LOGIN, PASSWORD_RESET, OFFBOARDING
  expiresAt   DateTime
  usedAt      DateTime?
  usedByIp    String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Forces a password change on next sign-in. P0 still gates the session, so a
/// forced-change user can read nothing sensitive until the reset completes.
model UserSecurityFlag {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mustChangePassword   Boolean   @default(false)
  mustChangeReason     String?
  accountDisabled      Boolean   @default(false)
  disabledReason       String?
  disabledAt           DateTime?
  passwordChangedAt    DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  updatedAt            DateTime  @updatedAt
}

/// Employee offboarding (P1.2). Historical HR/payroll/audit rows are retained;
/// offboarding disables access and changes status, it never deletes.
/// Onboarding checklist (P1.1 / FLOW-005).
///
/// Separate from OffboardingChecklistItem because the two lifecycles are
/// independent: an employee can be onboarded and never offboarded, and the
/// items differ. A requirement row is never treated as satisfied — `status`
/// stays PENDING until someone completes it, which is what the audit flagged
/// (FLOW-005: "Do not mark documents as complete merely because a checklist
/// item was created").
model OnboardingChecklistItem {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// PASS | VISA | PASSPORT | EMIRATES_ID | MEDICAL_INSURANCE | ILOE_INSURANCE | BANK | OFFER_LETTER | APPOINTMENT_LETTER | EQUIPMENT | POLICY_ACK
  category    String
  label       String
  required    Boolean  @default(true)
  /// PENDING | IN_PROGRESS | COMPLETED | WAIVED | BLOCKED
  status      String   @default("PENDING")
  /// Set only when a document was actually received and checked. A created
  /// requirement never satisfies itself.
  documentRef String?
  verifiedBy  String?
  verifiedAt  DateTime?
  notes       String?
  dueAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
  @@index([employeeId, category])
  // One row per category per employee: makes `ensureChecklist` idempotent even
  // under concurrent calls. Added by migration, not by `db push`, so no data is
  // at risk.
  @@unique([employeeId, category])
}

model OffboardingRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  status          String    @default("REQUESTED") // REQUESTED, IN_REVIEW, NOTICE_PERIOD, CLEARANCE, SETTLEMENT_PENDING, COMPLETED, CANCELLED
  lastWorkingDay  DateTime
  noticePeriodEnd DateTime?
  reason          String?
  exitNotes       String?
  initiatedBy     String
  approvedBy      String?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  checklist       OffboardingChecklistItem[]
  settlement      FinalSettlement?

  @@index([employeeId])
  @@index([status])
}

/// Exit checklist. Separate from the checklist item existing state: a created
/// requirement is never treated as a completed one.
model OffboardingChecklistItem {
  id                String             @id @default(cuid())
  offboardingId     String
  offboarding       OffboardingRequest  @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  label             String
  category          String             @default("GENERAL")
  status            String             @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, WAIVED, BLOCKED
  required          Boolean            @default(true)
  completedBy       String?
  completedAt       DateTime?
  notes             String?
  dueAt             DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([offboardingId, status])
}

/// Company property. Minimal structure — the minimum needed to record an
/// assignment and a return, not a duplicate asset-management system.
// ─── P1 JOINING & PROBATION ───────────────────────────────────────────────────

/// The explicit joining step (brief §18). An employee appearing in the system
/// is the outcome of this record, not an implicit side-effect.
model JoiningRecord {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id])
  /// Set once the hire has actually joined. Nullable because a joining can be
  /// scheduled before the person arrives.
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id])
  offerId         String?
  offer           OfferLetter? @relation(fields: [offerId], references: [id])
  joiningDate     DateTime
  /// SCHEDULED | JOINED | NO_SHOW | POSTPONED | CANCELLED
  status          String    @default("SCHEDULED")
  department      String?
  designation     String?
  employeeCode    String?
  probationEndDate DateTime?
  actualJoinedAt  DateTime?
  joinedBy        String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([candidateId])
  @@index([joiningDate])
}

/// Probation tracking (brief §21). Created automatically at joining when the
/// accepted offer carried a probation period.
model ProbationReview {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  /// NOT_STARTED | IN_PROGRESS | CONFIRMED | EXTENDED | FAILED
  status      String    @default("NOT_STARTED")
  managerId   String?
  reviewDate  DateTime?
  performanceRating Float?
  attendanceRating  Float?
  conductRating     Float?
  technicalRating   Float?
  communicationRating Float?
  teamworkRating    Float?
  overallRecommendation String? // CONFIRM, EXTEND, TERMINATE
  comments     String?
  hrApprovedBy String?
  hrApprovedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([endDate])
}

model Asset {
  id             String    @id @default(cuid())
  assetTag       String    @unique
  name           String
  category       String?
  serialNumber   String?
  description    String?
  condition      String    @default("GOOD") // NEW, GOOD, FAIR, DAMAGED, LOST
  status         String    @default("AVAILABLE") // AVAILABLE, ASSIGNED, RETURNS_DUE, RETIRED
  purchaseDate   DateTime?
  value          Float?
  currency       String    @default("AED")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  assignments    AssetAssignment[]
}

/// An asset cannot be assigned to two people at once: enforced by a partial
/// unique index created in the migration, not by application code alone.
model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id])
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  assignedAt DateTime  @default(now())
  assignedBy String
  returnedAt DateTime?
  returnedTo String?
  condition  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, returnedAt])
  @@index([assetId, returnedAt])
}

/// Final settlement. Intentionally NOT a UAE end-of-service calculator: the
/// business rules are not defined in this codebase, so the workflow is built
/// and the arithmetic is left as explicit, reviewable inputs.
model FinalSettlement {
  id                  String            @id @default(cuid())
  offboardingId       String            @unique
  offboarding         OffboardingRequest @relation(fields: [offboardingId], references: [id])
  status              String            @default("DRAFT") // DRAFT, CALCULATED, UNDER_REVIEW, APPROVED, PAID
  pendingSalaryDays   Float             @default(0)
  pendingSalaryAmount Float             @default(0)
  leaveEncashmentDays Float             @default(0)
  leaveEncashmentAmount Float           @default(0)
  loanDeductions      Float             @default(0)
  advanceDeductions   Float             @default(0)
  otherDeductions     Float             @default(0)
  otherAdditions      Float             @default(0)
  gratuityAmount      Float             @default(0)
  finalAmount         Float             @default(0)
  calculationNotes    String?
  approvedBy          String?
  approvedAt          DateTime?
  paidAt              DateTime?
  paidReference       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

/// Configurable leave policy (P1.3). Nothing about entitlement is hardcoded.
model LeaveAccrualPolicy {
  id                String   @id @default(cuid())
  leaveType         String
  annualEntitlement Int      @default(0)
  accrualFrequency  String   @default("ANNUAL") // MONTHLY, ANNUAL, MANUAL
  accrualAmount     Int      @default(0)
  carryForward      Boolean  @default(false)
  maximumBalance    Int?
  /// Manager approval alone finalises leave of this many days or fewer;
  /// anything longer also requires HR review. Configurable, not hardcoded.
  hrReviewThresholdDays Int  @default(5)
  requiresHrReview  Boolean  @default(true)
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([leaveType, effectiveFrom])
  @@index([leaveType, isActive])
  accrualRuns  LeaveAccrualRun[]
}

/// One row per policy per period makes accrual idempotent: a unique constraint
/// on (employeeId, policyId, period) means a second run for the same period
/// cannot double-credit anyone, even under concurrency.
model LeaveAccrualRun {
  id             String            @id @default(cuid())
  policyId       String
  policy         LeaveAccrualPolicy @relation(fields: [policyId], references: [id])
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  period         String // e.g. 2026-01 or 2026
  daysCredited   Int               @default(0)
  daysCarried    Int               @default(0)
  balanceAfter   Int               @default(0)
  status         String            @default("APPLIED") // APPLIED, SKIPPED
  skipReason     String?
  createdBy      String?
  createdAt      DateTime          @default(now())

  @@unique([employeeId, policyId, period])
  @@index([period])
}

/// Registered biometric terminal (P1.7, FLOW-025). The API secret is stored as
/// a SHA-256 hash only; the plaintext is shown once at creation and never again.
model AttendanceDevice {
  id               String    @id @default(cuid())
  name             String
  deviceIdentifier String    @unique
  location         String?
  status           String    @default("ACTIVE") // ACTIVE, DISABLED, REVOKED
  apiKeyHash       String    @unique
  keyPrefix        String // short public prefix, safe to display
  lastSyncAt       DateTime?
  lastSyncRecords  Int       @default(0)
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  revokedAt        DateTime?
  syncLogs         AttendanceSyncLog[]
}

/// Per-import outcome, so operators can see accepted / rejected / duplicate
/// counts without exposing any credential.
model AttendanceSyncLog {
  id                String           @id @default(cuid())
  deviceId          String
  device            AttendanceDevice @relation(fields: [deviceId], references: [id])
  fileName          String?
  totalRows         Int              @default(0)
  imported          Int              @default(0)
  duplicates        Int              @default(0)
  rejected          Int              @default(0)
  unknownEmployees  Int              @default(0)
  durationMs        Int?
  errorSummary      String?
  createdAt         DateTime         @default(now())

  @@index([deviceId, createdAt])
}

/// One row per document per reminder window. The unique constraint is what
/// makes "do not send the same reminder twice" a database guarantee (P1.6).
model DocumentExpiryReminder {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  documentType String    // VISA, PASSPORT, EMIRATES_ID, MEDICAL_INSURANCE, WORK_PERMIT, ILOE_INSURANCE
  documentId   String?
  thresholdDays Int
  expiryDate   DateTime
  recipientRole String   @default("EMPLOYEE") // EMPLOYEE, HR, MANAGER
  sentAt       DateTime  @default(now())
  deliveryId   String?

  @@unique([employeeId, documentType, thresholdDays, expiryDate])
  @@index([expiryDate])
}

/// Renewal workflow for an expiring document. Previous document history is
/// never deleted.
model DocumentRenewal {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  documentType String
  currentExpiry DateTime
  status       String    @default("REQUESTED") // REQUESTED, DOCUMENT_SUBMITTED, UNDER_REVIEW, RENEWED, REJECTED, CANCELLED
  newExpiry    DateTime?
  notes        String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([employeeId, status])
}

/// Payroll run header. Per-employee results stay in SalaryRecord; this tracks
/// the period lifecycle and makes locking and duplicate prevention explicit.
model PayrollRun {
  id             String    @id @default(cuid())
  month          Int
  year           Int
  status         String    @default("DRAFT") // DRAFT, CALCULATING, CALCULATED, UNDER_REVIEW, APPROVED, LOCKED, PAID, CANCELLED
  employeeCount  Int       @default(0)
  totalNet       Float     @default(0)
  totalDeductions Float    @default(0)
  lockedAt       DateTime?
  lockedBy       String?
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  paidReference  String?
  failureCount   Int       @default(0)
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([year, month])
  @@index([status])
}

/// Notification delivery attempts. Kept SEPARATE from Notification so a failed
/// email can never roll back the business transaction that created the record
/// (P1.8).
model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String?
  channel        String       // IN_APP, EMAIL, SMS
  recipient      String
  templateKey    String?
  status         String       @default("PENDING") // PENDING, SENT, FAILED, RETRYING, SKIPPED
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  lastError      String?
  externalId     String?
  nextRetryAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, nextRetryAt])
  @@index([recipient])
}


/// The existing AuditLog model requires an employeeId, which makes it
/// unsuitable for events that are not about one employee (role changes,
/// denied requests, seed attempts, sign-in failures).
model SecurityAuditLog {
  id            String   @id @default(cuid())
  action        String
  actorEmail    String?
  actorRole     String?
  target        String?
  outcome       String   @default("SUCCESS") // SUCCESS, DENIED, ERROR
  detail        Json?
  requestPath   String?
  requestMethod String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([actorEmail])
  @@index([createdAt])
}

// ─── EMPLOYEE MASTER TABLE (Central Entity) ───────────────────────────────────
model Employee {
  id                     String           @id @default(cuid())
  /// P1 GAP-01: nullable so an employee can be created before their login is
  /// provisioned or their visa is processed. A CHECK constraint
  /// (Employee_active_requires_employment_data) requires the full set once
  /// lifecycle is ACTIVE/CONFIRMED/PROBATION. Prisma cannot express CHECK
  /// constraints, so that guarantee lives in SQL only — see
  /// docs/audit/GAP01_MIGRATION_REVIEW.md
  userId                 String?          @unique
  user                   User?            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeCode           String?          @unique // Auto-generated: EMP-001
  firstName              String
  lastName               String
  email                  String           @unique
  rollNumber             String           @unique
  photo                  String?
  phone                  String?
  gender                 String?
  dateOfBirth            DateTime?
  nationality            String?
  maritalStatus          String?
  designation            String?
  department             String?
  joiningDate            DateTime?
  employmentType         String           @default("FULL_TIME")
  workLocation           String?
  probationDays          Int              @default(90)
  currentStatus          String           @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  isActive               Boolean          @default(true)
  address                String?
  permanentAddress       String?
  emergencyContact       String?
  emergencyPhone         String?
  governmentId           String?
  bankName               String?
  accountNumber          String?
  iban                   String?
  ifscCode               String?
  basicSalary            Float?
  housingAllowance       Float?
  transportAllowance     Float?
  otherAllowance         Float?
  passportNumber         String?
  passportExpiry         DateTime?
  emiratesId             String?
  emiratesIdExpiry       DateTime?
  visaNumber             String?
  visaExpiry             DateTime?
  visaType               String?
  medicalInsuranceExpiry DateTime?
  iloeInsuranceExpiry    DateTime?
  shiftId                String?
  shift                  Shift?           @relation(fields: [shiftId], references: [id])
  leaveRequests          LeaveRequest[]

  // --- P1 workflow relations ---
  offboardingRequests    OffboardingRequest[]
  assetAssignments       AssetAssignment[]
  accrualRuns            LeaveAccrualRun[]
  expiryReminders        DocumentExpiryReminder[]
  probationReviews      ProbationReview[]
  joiningRecords        JoiningRecord[]
  onboardingChecklist    OnboardingChecklistItem[]

  // --- P1 lifecycle (brief §40) ---
  /// Explicit employment stage. A single ACTIVE/RESIGNED flag cannot express
  /// probation, notice period or exit, so the stage is a separate field:
  /// PRE_JOINING | ACTIVE | PROBATION | CONFIRMED | ON_LEAVE |
  /// NOTICE_PERIOD | RESIGNED | TERMINATED | EXITED
  lifecycle        String        @default("PRE_JOINING")
  /// Provenance. Retained so a recruitment hire stays traceable to the
  /// requisition, application and offer it came from.
  sourceRequisitionId String?
  sourceCandidateId  String?
  documentRenewals       DocumentRenewal[]
  leaveBalances          LeaveBalance[]
  attendance             Attendance[]
  salaryStructure        SalaryStructure?
  salaryRecords          SalaryRecord[]
  letterRecords          LetterRecord[]
  serviceRequests        ServiceRequest[]
  visaRequests           VisaRequest[]
  letters                Letter[]
  letterRequests         LetterRequest[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  loanApplications       LoanApplication[]
  overtime               Overtime[]
  salaryAdvances         SalaryAdvanceRequest[]
  reimbursements         ReimbursementRequest[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  managerId              String?
  manager                Employee?        @relation("ManagerToStaff", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportees              Employee[]       @relation("ManagerToStaff")
  requestedJobs          JobRequisition[] @relation("RequestedJobs")
  /// P1: the interviewer relation moved to `InterviewParticipant` so a panel
  /// can have many interviewers. This now points at the join.
  interviewPanel  InterviewParticipant[]

  // --- Exit lifecycle (brief: resignation / termination / end of contract) ---
  /// One case per exit. A second live case is refused by the action, not by a
  /// unique constraint, so the error can name the case that is already open.
  exitCases      ExitCase[]
  /// Prior-employer rehire assessments. Points at the employee who LEFT, not
  /// at the one who came back.
  rehireRecords  RehireRecord[]

  // --- Indexes (P0-13) ---
  // Filters: active-employee dropdowns (attendance, shifts, payroll) and department scope.
  @@index([isActive])
  @@index([department, isActive])
  @@index([currentStatus])
}

// ─── LEAVE BALANCE (Auto-created on employee onboarding) ─────────────────────
model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leaveType  String // ANNUAL, SICK, CASUAL, EMERGENCY, UNPAID, MATERNITY, PATERNITY, etc.
  totalDays  Int      @default(0)
  usedDays   Int      @default(0)
  year       Int // Calendar year this balance applies to
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // --- Indexes (P0-13) ---
  // Balance lookup is always (employee, leaveType, year).
  @@index([employeeId, year])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title      String
  message    String
  type       String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead     Boolean  @default(false)
  link       String? // Optional deep link
  createdAt  DateTime @default(now())

  // --- Indexes (P0-13) ---
  // Per-employee notification feed reads.
  @@index([employeeId, createdAt])
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────
model Attendance {
  id              String         @id @default(cuid())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  date            DateTime
  checkIn         DateTime?
  checkOut        DateTime?
  status          String         @default("PRESENT") // PRESENT, ABSENT, LATE, LEAVE, HOLIDAY
  lateMinutes     Int            @default(0)
  overtimeMinutes Int            @default(0)
  shiftId         String?
  shift           Shift?         @relation(fields: [shiftId], references: [id])
  biometricLogs   BiometricLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // --- Indexes (P0-13) ---
  // Import duplicate check and per-employee daily lookups.
  @@index([employeeId, date])
  @@index([date])
}

model Shift {
  id                        String       @id @default(cuid())
  name                      String
  startTime                 String
  endTime                   String
  lateThreshold             Int          @default(15)
  monthlyLateThresholdHours Int          @default(4)
  weeklyOffs                String
  employees                 Employee[]
  attendance                Attendance[]
}

model BiometricLog {
  id           String      @id @default(cuid())
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  deviceId     String?
  employeeId   String
  timestamp    DateTime
  type         String // IN, OUT
  rawLog       String?

  // --- P1.7 import idempotency ---
  // Fingerprint of (device, employee, timestamp, type). The unique constraint
  // is what makes "the same punch is never processed twice" a database
  // guarantee rather than a hopeful read-then-write check, which two concurrent
  // imports would both pass.
  //
  // MIGRATION SEQUENCE USED (no --accept-data-loss, no row deleted):
  //   1. column added as nullable, `db push`
  //   2. existing rows backfilled deterministically from values they already
  //      hold, then a duplicate check, then CREATE UNIQUE INDEX by hand
  //   3. `@unique` restored in the schema, `db push` — the index already
  //      exists, so nothing is altered
  //
  // Nullable rather than NOT NULL because step 2 is a data backfill, and the
  // project does not use --accept-data-loss.
  punchHash String? @unique

  @@index([employeeId, timestamp])
  @@index([deviceId, timestamp])
}

/// Per-employee audit trail. `employeeId` is NULLABLE, and that is deliberate.
///
/// WHY NULLABLE — AND WHY NOT A SENTINEL, AND WHY NOT THE ACTOR
/// -----------------------------------------------------------
/// This model is scoped to an employee, which made it unusable for events that
/// are not about one: an application received, an interview scheduled, an offer
/// created, an offer letter issued. Those call sites passed
/// `employeeId: "SYSTEM"` — a value with no matching `Employee` row — and
/// Postgres refused every one of them with
/// `P2003 / AuditLog_employeeId_fkey`. Because the writes sit inside
/// `prisma.$transaction`, the entire feature rolled back rather than merely
/// losing its audit row: an offer could not be created, so no offer letter
/// could ever be issued.
///
/// Three ways out were considered.
///
/// (a) The CANDIDATE's id. REJECTED. `Candidate.id` and `Employee.id` are both
///     `@default(cuid())` — the SAME id namespace, with nothing in the value to
///     distinguish a person who applied from a person who was hired. A row filed
///     under a candidate id resolves through the `employee` relation to a real
///     and DIFFERENT person the moment the two generators collide, and until
///     then it sits in that person's per-employee trail doing nothing. A
///     plausible wrong answer is worse than an honest empty one.
///
/// (b) The ACTING employee's id (`user.employeeId`). REJECTED. It silently
///     redefines this column from "the employee this happened TO" into "the
///     employee who pressed the button", but only on some rows — `employeeId`
///     means "subject" everywhere else (leave, payroll, exit, onboarding,
///     attendance), and the sibling fix in `submitInterviewFeedback` rejected
///     precisely this substitution in favour of the subject
///     (`participant.interviewerId`). It is not reliably available either:
///     `SessionUser.employeeId` is `string | null`, because staged employee
///     entry (GAP-01) permits a User with no Employee row. So (b) would only
///     trade a guaranteed failure for a data-dependent one.
///
/// (c) NULL, with the column nullable. CHOSEN. The subject of an offer event is
///     a candidate who has not joined, and §19 is explicit that the Employee
///     record is created at the joining stage. There is no employee to point
///     at; inventing one is what produced this bug. Nothing is lost: `changedBy`
///     is NOT NULL on every row and still records the actor, and `details`
///     names the subject. Checked before choosing: the only reader of this table
///     in the application is `app/dashboard/page.tsx`, which takes the newest
///     rows unfiltered and renders `action`/`details`/`createdAt`; nothing
///     filters by `employeeId` or includes the `employee` relation, and
///     `lib/observability/retention.ts` prunes `SecurityAuditLog`, not this
///     table. `@@index([employeeId, createdAt])` still works — Postgres indexes
///     NULLs — and a per-employee read simply never matches these rows, which
///     is the correct answer for an event that was never about that employee.
///
/// This RELAXES no integrity. A non-null `employeeId` is still a hard foreign
/// key to `Employee` and still cannot name a person who does not exist. NULL is
/// the only new value it accepts, and it carries exactly one meaning: "this
/// event is not about an employee".
model AuditLog {
  id String @id @default(cuid())
  /// NULL when the event's subject is not (yet) an Employee — a candidate, a
  /// device, a system-level change. See the note above.
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  action     String
  details    String?
  changedBy  String
  createdAt  DateTime @default(now())

  // --- Indexes (P0-13) ---
  // Per-employee audit trail reads.
  @@index([employeeId, createdAt])
}

// ─── LEAVE ────────────────────────────────────────────────────────────────────
model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  type          String
  startDate     DateTime
  endDate       DateTime
  reason        String
  managerStatus String   @default("PENDING")
  managerId     String?
  manager       User?    @relation("ManagerApprovals", fields: [managerId], references: [id])
  hrStatus      String   @default("PENDING")
  hrId          String?
  hr            User?    @relation("HRApprovals", fields: [hrId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- P1.3 explicit state machine + half-day support ---
  /// PENDING_MANAGER | MANAGER_APPROVED | PENDING_HR | APPROVED | REJECTED | CANCELLED
  /// Denormalised from managerStatus/hrStatus so the workflow has ONE status a
  /// state machine can validate, rather than two independent columns that can
  /// disagree with each other.
  status       String    @default("PENDING_MANAGER")
  /// FULL_DAY | HALF_DAY_FIRST_HALF | HALF_DAY_SECOND_HALF
  dayPart      String    @default("FULL_DAY")
  /// Days actually deducted, computed once at approval. A half day is 0.5 —
  /// never a fake date range.
  deductedDays Float     @default(0)
  /// Balance row credited at approval, so a reversal can find it.
  balanceId    String?
  decidedAt    DateTime?
  /// Why the request entered its current state; surfaced in the approval UI.
  decisionNote String?
  cancelledById String?
  cancelledAt  DateTime?

  // --- Indexes (P0-13) ---
  // Approval queues filter on the two workflow status columns.
  @@index([managerStatus])
  @@index([hrStatus])
  @@index([employeeId, createdAt])
  @@index([status])
  @@index([status, type])
}

// ─── PAYROLL ──────────────────────────────────────────────────────────────────
model SalaryStructure {
  id                 String   @id @default(cuid())
  employeeId         String   @unique
  employee           Employee @relation(fields: [employeeId], references: [id])
  ctc                Float    @default(0)
  basic              Float    @default(0)
  housingAllowance   Float    @default(0)
  transportAllowance Float    @default(0)
  medicalAllowance   Float    @default(0)
  foodAllowance      Float    @default(0)
  travelAllowance    Float    @default(0)
  commission         Float    @default(0)
  otherAllowances    Float    @default(0)
  paymentMethod      String   @default("BANK_TRANSFER")
  bankName           String?
  iban               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SalaryRecord {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id])
  month              Int
  year               Int
  basic              Float
  housingAllowance   Float     @default(0)
  transportAllowance Float     @default(0)
  medicalAllowance   Float     @default(0)
  foodAllowance      Float     @default(0)
  travelAllowance    Float     @default(0)
  commission         Float     @default(0)
  otherAllowances    Float     @default(0)
  latePenalty        Float     @default(0)
  penalty            Float     @default(0)
  leaveDeduction     Float     @default(0)
  loanDeduction      Float     @default(0)
  advanceSalary      Float     @default(0)
  otherDeductions    Float     @default(0)
  overtimePay        Float     @default(0)
  bonus              Float     @default(0)
  netSalary          Float
  status             String    @default("DRAFT") // DRAFT, LOCKED, PAID, CANCELLED
  paymentMethod      String    @default("BANK_TRANSFER")
  paidAt             DateTime?

  // P1.4: one record per employee per period. This is the duplicate-prevention
  // guarantee — a second payroll run for the same month cannot insert a second
  // row, so re-running is safe and resumable.
  @@unique([employeeId, year, month])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // --- Indexes (P0-13) ---
  // Payroll period queries filter on (year, month).
  @@index([year, month])
  @@index([employeeId, year, month])
}

model LoanType {
