# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# `.env*` also matches `.env.example`, which MUST be committed as a
# placeholder template. The negation below re-includes only that file; every
# real `.env`, `.env.local`, `.env.production` etc. stays ignored.
.env*
!.env.example

# Prisma query-engine temp copies. When the dev server is killed while holding
# the engine DLL, Prisma leaves a 21MB `.tmpNNNNN` duplicate behind. These are
# pure build artefacts and must never be committed.
#
# Matched at ANY depth: the legacy hr-system/ tree carries its own generated
# client, and a root-anchored rule silently missed it.
**/prisma/generated/client/*.tmp*
**/prisma/generated/client/**/*.tmp*

# Runtime logs
firebase-debug.log
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

.vercel
